{
  "version": 9,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 30,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "dev-common",
      "hidden": true,
      "generator": "Ninja",
      "inherits": [
        "dev-mode"
      ],
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "dev-Linux",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "inherits": [
        "dev-common",
        "ci-Linux"
      ]
    },
    {
      "name": "dev-Darwin",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "inherits": [
        "dev-common",
        "ci-Darwin"
      ],
      "cacheVariables": {
        "CMAKE_CXX_STDLIB_MODULES_JSON": "$env{CMAKE_CXX_STDLIB_MODULES_JSON}"
      }
    },
    {
      "name": "dev-Windows",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "inherits": [
        "dev-common",
        "ci-windows"
      ],
      "environment": {
        "UseMultiToolTask": "true",
        "EnforceProcessCountAcrossBuilds": "true"
      }
    },
    {
      "name": "dev",
      "binaryDir": "${sourceDir}/build/dev",
      "inherits": "dev-<hostSystemName>"
    },
    {
      "name": "dev-trace",
      "inherits": "dev",
      "trace": {
        "mode": "expand",
        "source": [
          "CMakeDetermineCompilerSupport.cmake",
          "CMakeDetermineCompilerId.cmake",
          "Clang-CXX-CXXImportStd.cmake"
        ]
      }
    },
    {
      "name": "dev-coverage",
      "binaryDir": "${sourceDir}/build/coverage",
      "inherits": [
        "dev-mode",
        "coverage-Linux"
      ]
    }
  ],
  "buildPresets": [
    {
      "name": "dev",
      "configurePreset": "dev",
      "configuration": "Release",
      "jobs": 1,
      "verbose": true,
      "targets": [
        "all_verify_interface_header_sets",
        "install"
      ]
    }
  ],
  "testPresets": [
    {
      "name": "dev",
      "configurePreset": "dev",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "jobs": 12,
        "noTestsAction": "error"
      }
    }
  ],
  "packagePresets": [
    {
      "name": "dev",
      "configurePreset": "dev",
      "generators": [
        "TGZ"
      ]
    }
  ],
  "workflowPresets": [
    {
      "name": "dev",
      "steps": [
        {
          "type": "configure",
          "name": "dev"
        },
        {
          "type": "build",
          "name": "dev"
        },
        {
          "type": "test",
          "name": "dev"
        },
        {
          "type": "package",
          "name": "dev"
        }
      ]
    }
  ]
}
